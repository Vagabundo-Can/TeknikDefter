<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/widget_bg" android:padding="8dp">
    <ImageView android:id="@+id/w_logo" android:layout_width="40dp" android:layout_height="40dp"
        android:src="@mipmap/ic_launcher" android:layout_marginEnd="6dp" android:contentDescription="Teknik Defter"/>
    <TextView android:id="@+id/w_new" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
        android:text="＋ Yeni not" android:gravity="center" android:textColor="#263238" android:textSize="13sp"
        android:background="@drawable/widget_btn" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/w_call" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
        android:text="☎ Arama notu" android:gravity="center" android:textColor="#263238" android:textSize="13sp"
        android:background="@drawable/widget_btn" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/w_last" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
        android:text="Son sayfa" android:gravity="center" android:textColor="#263238" android:textSize="13sp"
        android:maxLines="2" android:ellipsize="end" android:background="@drawable/widget_btn"/>
</LinearLayout>
